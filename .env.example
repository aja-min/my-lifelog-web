# Googleログイン（OAuthクライアント。Driveサービスアカウントとは別）
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 自分のGoogleアカウント1件のみ
ALLOWED_EMAIL=
NEXTAUTH_URL=http://localhost:3000
# openssl rand -base64 32
NEXTAUTH_SECRET=

# このIDの直下にある日次Markdownだけを読む
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# JSON鍵の private_key。改行は \n のまま二重引用符で囲む
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=""

# 架空データのローカル開発用。本番（next start / Vercel）では無効
DEMO_MODE=false
